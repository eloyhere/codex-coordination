{
  "name": "codex-coordination",
  "version": "0.2.0",
  "private": true,
  "description": "A Codex plugin that keeps a durable AMP coordination ledger beside a repository: strict AMP Goal and Plan artifacts, accountable handoffs and an append-only ledger-snapshot chain, exposed as five MCP tools and four skills.",
  "keywords": [
    "codex",
    "codex-plugin",
    "mcp",
    "coordination",
    "amp",
    "attention-manifest-protocol",
    "goals",
    "plans",
    "handoffs",
    "ledger"
  ],
  "license": "Apache-2.0",
  "author": "Eloy Kim <eloy.kim@outlook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eloyhere/codex-coordination.git"
  },
  "bugs": {
    "url": "https://github.com/eloyhere/codex-coordination/issues"
  },
  "homepage": "https://github.com/eloyhere/codex-coordination#readme",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "smoke": "node scripts/mcp-smoke.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "check": "npm run validate && npm test && npm run smoke",
    "conformance": "node scripts/amp-conformance.mjs",
    "snapshot": "node scripts/amp-snapshot.mjs",
    "serve": "node plugins/codex-coordination/mcp/server.mjs"
  },
  "files": [
    ".agents/plugins/marketplace.json",
    "plugins/codex-coordination/**",
    "docs/**",
    "scripts/**",
    "test/**",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ]
}
