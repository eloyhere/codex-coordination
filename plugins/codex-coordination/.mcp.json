{
  "mcpServers": {
    "coordination": {
      "command": "cmd.exe",
      "args": [
        "/d",
        "/s",
        "/c",
        "call",
        "./scripts/launch-mcp.cmd"
      ],
      "cwd": ".",
      "startup_timeout_sec": 20,
      "tool_timeout_sec": 120,
      "env_vars": [
        "PATH",
        "PATHEXT",
        "SystemRoot",
        "SYSTEMROOT",
        "LOCALAPPDATA",
        "APPDATA",
        "USERPROFILE",
        "ProgramFiles",
        "ProgramW6432",
        "NODE_EXE",
        "CODEX_COORDINATION_WORKSPACE",
        "CODEX_COORDINATION_DEBUG",
        "CODEX_COORDINATION_SCHEMA_DETAIL",
        "CODEX_AMP_DATABASE",
        "CODEX_AMP_SEARCH_NODE",
        "CODEX_AMP_HOST_CONFIG",
        "CODEX_AMP_CODEX_EXE",
        "CODEX_AMP_CONTROL_SOCKET",
        "CODEX_AMP_GOAL_DB",
        "AMP_LLM_API_KEY",
        "AMP_SEARCH_API_KEY",
        "AMP_SEARCH_PASSWORD",
        "AMP_SEARCH_BEARER",
        "DEEPSEEK_API_KEY",
        "DEEPSEEK_BASE_URL",
        "DEEPSEEK_MODEL",
        "OPENAI_API_KEY"
      ]
    }
  }
}
